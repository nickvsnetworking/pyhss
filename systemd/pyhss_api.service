# Optional HTTP server providing an API for managing PyHSS.
[Unit]
Description=PyHSS API Service
After=network.target
Requires=pyhss_hss.service
After=pyhss_hss.service

[Service]
Environment="PYTHONUNBUFFERED=1"
Environment="PYHSS_LOG_STDOUT_NO_TIMESTAMP=1"
User=root
WorkingDirectory=/etc/pyhss/services/
ExecStart=python3 apiService.py
Restart=always

[Install]
WantedBy=multi-user.target
